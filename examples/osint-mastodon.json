{
  "name": "OSINT and infosec community (Mastodon only, no credentials)",
  "tags": ["osint", "infosec", "cybersecurity"],
  "terms": [],
  "days": 7,
  "db": "osint.sqlite",
  "report": "osint_report.html",
  "pause_seconds": 0.5,
  "sources": {
    "mastodon": {"enabled": true, "instances": ["mastodon.social", "fosstodon.org", "infosec.exchange", "mstdn.social"], "max_pages": 5},
    "bluesky":  {"enabled": false},
    "x":        {"enabled": false}
  },
  "alert": {"window_minutes": 30, "uses": 200, "ratio": 10, "uses_per_account": 5, "min_uses": 10},
  "burst": {"window_minutes": 10, "minimum": 3},
  "discover": {"auto": false, "max_new_per_cycle": 1, "max_tags": 12, "min_accounts": 3, "min_posts": 3, "show": 25}
}
