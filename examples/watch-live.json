{
  "name": "Live watch, three sources, incremental X reads",
  "tags": ["osint"],
  "terms": [],
  "days": 7,
  "db": "watch.sqlite",
  "report": "watch_report.html",
  "pause_seconds": 0.5,
  "sources": {
    "mastodon": {"enabled": true, "instances": ["mastodon.social", "fosstodon.org"], "max_pages": 3},
    "bluesky":  {"enabled": true, "max_pages": 3},
    "x":        {"enabled": true, "max_posts_per_tag": 50, "budget_usd": 10.0, "query_extra": "-is:retweet", "archive": false, "sample_per_day": 0, "counts_every_minutes": 60}
  },
  "alert": {"window_minutes": 30, "uses": 200, "ratio": 10, "uses_per_account": 5, "min_uses": 10},
  "burst": {"window_minutes": 10, "minimum": 3},
  "discover": {"auto": true, "max_new_per_cycle": 1, "max_tags": 8, "min_accounts": 5, "min_posts": 5, "show": 25}
}
