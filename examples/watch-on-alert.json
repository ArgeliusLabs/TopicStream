{
  "name": "Tripwire: counts only until an hour trips a rule, then that hour complete",
  "tags": ["PHP2Shell"],
  "terms": ["CVE-2026-109618"],
  "days": 7,
  "db": "tripwire.sqlite",
  "report": "tripwire_report.html",
  "pause_seconds": 0.5,
  "sources": {
    "mastodon": {"enabled": true, "instances": ["mastodon.social", "fosstodon.org"], "max_pages": 3},
    "bluesky":  {"enabled": false},
    "x":        {"enabled": true, "read_mode": "on_alert", "budget_usd": 10.0, "query_extra": "-is:retweet", "archive": false, "counts_every_minutes": 60}
  },
  "alert": {"window_minutes": 60, "uses": 200, "ratio": 10, "uses_per_account": 5, "min_uses": 10},
  "burst": {"window_minutes": 10, "minimum": 3, "paraphrase_window_minutes": 60, "paraphrase_threshold": 0.35},
  "discover": {"auto": false, "max_new_per_cycle": 1, "max_tags": 12, "min_accounts": 3, "min_posts": 3, "show": 25}
}
